{
  "Version": "2012-10-17",
  "Comment": "Attach to the ECS task role (what the containers may do). Replace <REGION>/<ACCOUNT_ID>/<BUCKET>. Tighten the Bedrock Resource to your model + inference-profile ARNs once known.",
  "Statement": [
    {
      "Sid": "S3Docs",
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:PutObject", "s3:DeleteObject", "s3:ListBucket"],
      "Resource": ["arn:aws:s3:::<BUCKET>", "arn:aws:s3:::<BUCKET>/*"]
    },
    {
      "Sid": "SqsIngestion",
      "Effect": "Allow",
      "Action": ["sqs:SendMessage", "sqs:ReceiveMessage", "sqs:DeleteMessage", "sqs:GetQueueAttributes"],
      "Resource": [
        "arn:aws:sqs:<REGION>:<ACCOUNT_ID>:act-ingestion",
        "arn:aws:sqs:<REGION>:<ACCOUNT_ID>:act-ingestion-dlq"
      ]
    },
    {
      "Sid": "Bedrock",
      "Effect": "Allow",
      "Action": ["bedrock:InvokeModel", "bedrock:InvokeModelWithResponseStream"],
      "Resource": ["*"]
    }
  ]
}
