{
  "family": "act-erp-ai-worker",
  "requiresCompatibilities": ["FARGATE"],
  "networkMode": "awsvpc",
  "cpu": "512",
  "memory": "1024",
  "executionRoleArn": "arn:aws:iam::${ACCOUNT_ID}:role/act-erp-ai-exec",
  "taskRoleArn": "arn:aws:iam::${ACCOUNT_ID}:role/act-erp-ai-task",
  "containerDefinitions": [
    {
      "name": "worker",
      "image": "${AI_IMAGE}",
      "essential": true,
      "command": ["python", "-m", "act_ai.worker"],
      "environment": [
        { "name": "AWS_REGION", "value": "${REGION}" },
        { "name": "S3_BUCKET", "value": "${S3_BUCKET}" },
        { "name": "SQS_QUEUE_URL", "value": "${SQS_QUEUE_URL}" },
        { "name": "EMBED_FAKE", "value": "false" },
        { "name": "EMBED_MODEL", "value": "${EMBED_MODEL}" }
      ],
      "secrets": [
        { "name": "DATABASE_URL", "valueFrom": "${SECRET_DATABASE_URL}" },
        { "name": "DATALAB_API_KEY", "valueFrom": "${SECRET_DATALAB_API_KEY}" }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/act-erp-ai",
          "awslogs-region": "${REGION}",
          "awslogs-stream-prefix": "worker"
        }
      }
    }
  ]
}
