# Next.js (apps/web) production image. Uses Next standalone output.
FROM node:22-slim AS base
RUN corepack enable
WORKDIR /app

FROM base AS deps
# pnpm-workspace.yaml carries onlyBuiltDependencies/ignoredBuiltDependencies.
# Without it, modern pnpm aborts the install with ERR_PNPM_IGNORED_BUILDS.
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
# pnpm still refuses to run build scripts (prisma, esbuild, ...) without an
# explicit approval, even when onlyBuiltDependencies lists them — there's no
# install flag for this, only the `approve-builds` subcommand. Install without
# scripts first, approve everything pnpm-workspace.yaml already allow-lists,
# then `rebuild` — a second `install` is a no-op here (node_modules already
# matches the lockfile) and would silently skip the now-approved scripts.
RUN pnpm install --frozen-lockfile --ignore-scripts \
 && pnpm approve-builds --all \
 && pnpm rebuild

FROM base AS build
COPY --from=deps /app/node_modules ./node_modules
COPY . .
# `next build` executes module code while analyzing routes, so env.ts's Zod
# validation runs at build time too — real-shaped values are required, not
# just at container runtime. Mounted as a build secret (not COPY'd) so the
# values exist only for this one RUN step and are never written into any
# image layer. Target name matters: Next only auto-loads ".env.production",
# not arbitrary filenames.
RUN --mount=type=secret,id=env_prod,target=/app/.env.production \
    pnpm prisma generate && pnpm build

FROM node:22-slim AS runner
WORKDIR /app
ENV NODE_ENV=production
# Business timezone (the database always stores UTC). Also set in compose.
ENV TZ=America/Chicago
ENV HOSTNAME=0.0.0.0
# Requires `output: "standalone"` in next.config.ts (added in Phase 8 deploy prep).
COPY --from=build /app/.next/standalone ./
COPY --from=build /app/.next/static ./.next/static
COPY --from=build /app/public ./public
# PDF.js is a serverExternalPackage: Next traces pdf.mjs but not the sibling
# worker it imports at runtime. Place the worker beside every traced pdf.mjs
# so paystub / hire-packet text extraction works in this slim image.
COPY --from=build /app/node_modules/pdfjs-dist/legacy/build/pdf.worker.mjs /tmp/pdf.worker.mjs
RUN set -eu; \
    found=0; \
    for f in $(find /app -type f \( -path '*/pdfjs-dist/*/legacy/build/pdf.mjs' -o -path '*/pdfjs-dist/legacy/build/pdf.mjs' \)); do \
      cp /tmp/pdf.worker.mjs "$(dirname "$f")/pdf.worker.mjs"; \
      found=1; \
    done; \
    test "$found" = 1; \
    rm -f /tmp/pdf.worker.mjs; \
    # Drop incomplete package trees that would shadow the traced pdfjs-dist.
    if [ -d /app/node_modules/pdfjs-dist ] && [ ! -f /app/node_modules/pdfjs-dist/package.json ]; then \
      rm -rf /app/node_modules/pdfjs-dist; \
    fi
EXPOSE 3000
CMD ["node", "server.js"]
