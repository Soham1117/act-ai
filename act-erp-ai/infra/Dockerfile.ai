# Single image for both the agent service and the ingestion worker.
# Entrypoint (uvicorn vs python -m act_ai.worker) is chosen by the compose/ECS command.
FROM python:3.12-slim

# LibreOffice is the DOCX->PDF fallback for ingestion (Phase 4). Kept minimal.
RUN apt-get update \
    && apt-get install -y --no-install-recommends libreoffice-writer \
    && rm -rf /var/lib/apt/lists/*

# uv for fast, reproducible installs.
COPY --from=ghcr.io/astral-sh/uv:latest /uv /usr/local/bin/uv

WORKDIR /app
COPY pyproject.toml ./
RUN uv pip install --system --no-cache .

COPY . .

EXPOSE 8001
CMD ["uvicorn", "act_ai.main:app", "--host", "0.0.0.0", "--port", "8001"]
