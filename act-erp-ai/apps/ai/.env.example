# Copy to apps/ai/.env for local dev. Locked defaults match ARCHITECTURE.md.

# Database (Prisma owns the schema; this connects as the read-mostly RLS role)
DATABASE_URL=postgresql://act:act@postgres:5432/act
# RLS_DATABASE_URL=postgresql://act_rls:act@postgres:5432/act   # set once Phase 1 creates the role

# Model provider. Local dev uses Gemini via LiteLLM (see llm/models.yaml);
# production swaps models.yaml to Bedrock. Set your Gemini key for the live run:
GEMINI_API_KEY=
# Set true to use deterministic local embeddings (no model needed); false uses
# the embeddings model from models.yaml (Gemini locally / Titan in prod).
EMBED_FAKE=false

# AWS / Bedrock (prod; us-east-2, Llama 3.3 70B + Titan v2)
AWS_REGION=us-east-2
EMBED_DIMS=1024

# Object storage / queue — LocalStack locally; unset AWS_ENDPOINT_URL in prod
S3_BUCKET=act-erp-ai-docs
SQS_QUEUE_URL=http://localstack:4566/000000000000/act-ingestion
AWS_ENDPOINT_URL=http://localstack:4566
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

# Document parsing (Datalab Marker)
DATALAB_API_KEY=

# Service-to-service auth (web -> agent). Generate a strong value; mirror in web.
INTERNAL_SERVICE_TOKEN=dev-insecure-change-me
