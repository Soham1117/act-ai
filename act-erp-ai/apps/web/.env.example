# ─────────────────────────────────────────────────────────────────────
# ACT ERP — environment variables
# Copy this file to .env.local and fill in the blanks. Do not commit.
# ─────────────────────────────────────────────────────────────────────

# Node environment (development | production | test)
NODE_ENV=development

# ── Postgres ────────────────────────────────────────────────────────
# Local dev points at the docker `act` DB; prod uses RDS (from Secrets Manager).
DATABASE_URL=postgresql://act:act@localhost:5432/act
DIRECT_URL=postgresql://act:act@localhost:5432/act

# ── Auth (NextAuth v5, credentials) ─────────────────────────────────
# Signing secret. Generate: openssl rand -base64 32
AUTH_SECRET=replace-with-openssl-rand-base64-32
# Create the first admin:
#   pnpm tsx --env-file=.env.local scripts/create-admin.ts you@actools.com 'StrongPass#1' 'Your Name'

# ── AWS / storage / queue (Phase 3) ─────────────────────────────────
# Local dev uses LocalStack (S3+SQS). In prod: omit AWS_ENDPOINT_URL and creds
# (the Fargate task IAM role provides them).
AWS_REGION=us-east-2
AWS_ENDPOINT_URL=http://localhost:4566
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
S3_BUCKET=act-erp-ai-docs
SQS_QUEUE_URL=http://localhost:4566/000000000000/act-ingestion

# ── Login-code email ────────────────────────────────────────────────
# Local development defaults to SES/LocalStack. Production should use
# microsoft-graph; see docs/MICROSOFT-GRAPH-EMAIL.md.
EMAIL_PROVIDER=ses
SES_FROM_EMAIL=noreply@americancompletiontools.com
# MICROSOFT_TENANT_ID=
# MICROSOFT_CLIENT_ID=
# MICROSOFT_CLIENT_SECRET=
# MICROSOFT_SENDER_USER=noreply@americancompletiontools.com

# Kiosk activation and punches are restricted to these exact public IPs or
# IPv4 CIDRs. Production fails closed if this is blank.
KIOSK_ALLOWED_NETWORKS=127.0.0.1,::1

# ── Agent service (apps/ai) — internal; must match the AI service token ──
AGENT_SERVICE_URL=http://localhost:8001
INTERNAL_SERVICE_TOKEN=dev-insecure-change-me

# ── App ─────────────────────────────────────────────────────────────
# Base URL of the running site (used in invite links, redirects).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Set to "true" to skip env validation (CI builds, Docker layers, etc.).
SKIP_ENV_VALIDATION=false

# ── Hire packet import (optional LLM gap-fill) ───────────────────────
# Claude API key from console.anthropic.com — used only when templates miss fields.
# ANTHROPIC_API_KEY=
# Optional model override (default: claude-3-5-haiku-20241022)
# ANTHROPIC_MODEL=
