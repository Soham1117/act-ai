# ─────────────────────────────────────────────────────────────────────
# ACT ERP — environment variables
# Copy this file to .env.local and fill in the blanks. Do not commit.
# ─────────────────────────────────────────────────────────────────────

# Node environment (development | production | test)
NODE_ENV=development

# ── Supabase ────────────────────────────────────────────────────────
# Project URL: https://app.supabase.com → your project → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co

# Public anon key (safe to expose to the browser)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIs...

# Service-role key — SERVER ONLY. Bypasses RLS. Never expose to client.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIs...

# ── Postgres (Supabase) ─────────────────────────────────────────────
# Pooled connection string for serverless / the app. Includes ?pgbouncer=true.
# Settings → Database → Connection string → "Transaction" pooler.
DATABASE_URL=postgresql://postgres.YOUR-PROJECT:PASSWORD@aws-0-us-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1

# Direct (unpooled) connection — used by Prisma migrations.
# Settings → Database → Connection string → "Direct connection".
DIRECT_URL=postgresql://postgres.YOUR-PROJECT:PASSWORD@aws-0-us-east-1.pooler.supabase.com:5432/postgres

# ── App ─────────────────────────────────────────────────────────────
# Base URL of the running site (used in invite links, redirects).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Set to "true" to skip env validation (CI builds, Docker layers, etc.).
SKIP_ENV_VALIDATION=false
