// =====================================================================
// ACT ERP — Prisma schema (Phases 0–7)
// Includes pgvector embeddings + audit log infrastructure.
// =====================================================================

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions", "fullTextSearchPostgres"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  directUrl  = env("DIRECT_URL")
  extensions = [pgvector(map: "vector"), pg_trgm]
}

// ──────────────────────────────────────────────────────────────────────
// Identity / RBAC
// ──────────────────────────────────────────────────────────────────────

/// Mirror of Supabase `auth.users`. We store the public profile + the
/// link to our `Employee` record. `id` matches `auth.users.id` (uuid).
///
/// Two roles only: ADMIN and EMPLOYEE. Admins implicitly have employee
/// access — `requireAdmin` gates admin-only routes; `requireUser` lets
/// either role through, so admins can use the employee dashboard too.
model User {
  id           String     @id @default(uuid()) @db.Uuid
  /// Login email — optional. Some employees (part-time / shop floor hires)
  /// have no company email at all and log in via `username` instead.
  email        String?    @unique
  /// Login identifier for employees with no company email (part-time / shop
  /// floor hires). Login accepts either this OR email. Null for users who
  /// sign in with email.
  username     String?    @unique
  /// 2FA code destination for users with no Employee record (bootstrap /
  /// system admin accounts). Employee.personalEmail takes priority when both
  /// exist — this is only the fallback for admins who aren't also modeled
  /// as a full HR employee (gender, SSN, etc. don't make sense for those).
  personalEmail String?
  name         String
  profileImage String?
  role         Role       @default(EMPLOYEE)
  /// bcrypt hash for credentials auth (NextAuth). Null until a password is set
  /// (e.g. legacy/SSO users). See lib/auth.
  passwordHash String?
  /// Bumped to revoke all of a user's JWT sessions instantly (logout-everywhere,
  /// role change, disable). getSessionUser compares this against the token.
  tokenVersion Int        @default(0)
  employee     Employee?
  loginChallenges LoginChallenge[]
  auditLogs    AuditLog[] @relation("ActorAuditLogs")
  // Agentic RAG relations (act-erp-ai)
  knowledgeUploads KnowledgeDocument[] @relation("KnowledgeUploads")
  knowledgeOwned   KnowledgeDocument[] @relation("KnowledgeOwned")
  documentGrants   DocumentGrant[]     @relation("KnowledgeGrants")
  agentRuns        AgentRun[]          @relation("AgentRuns")
  chatSessions     ChatSession[]       @relation("ChatSessions")
  hirePacketImports HirePacketImport[] @relation("HirePacketUploads")
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([email])
}

/// A pending email-2FA login. Created after password verification succeeds;
/// consumed (or expires) before a real session is issued. The code itself is
/// never stored — only its hash, same principle as passwords/kiosk PINs.
model LoginChallenge {
  id         String    @id @default(cuid())
  userId     String    @db.Uuid
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash   String
  attempts   Int       @default(0)
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId])
}

/// A saved Assistant conversation (one per chat thread, per user).
model ChatSession {
  id        String        @id @default(cuid())
  userId    String        @db.Uuid
  user      User          @relation("ChatSessions", fields: [userId], references: [id], onDelete: Cascade)
  title     String
  messages  ChatMessage[]
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([userId, updatedAt(sort: Desc)])
}

model ChatMessage {
  id        String      @id @default(cuid())
  sessionId String
  session   ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  /// "user" | "assistant"
  role      String
  content   String      @db.Text
  /// Assistant turns: { [eid]: CitationInfo } so citation chips keep working on reload.
  citations Json?
  createdAt DateTime    @default(now())

  @@index([sessionId, createdAt])
}

// ──────────────────────────────────────────────────────────────────────
// Org structure
// ──────────────────────────────────────────────────────────────────────

model Department {
  id          String     @id @default(cuid())
  name        String     @unique
  code        String?    @unique // optional short code, e.g. 'ENG' for Engineering
  description String?
  employees   Employee[]
  jobCodes    JobCode[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

model JobCode {
  id           String              @id @default(cuid())
  code         String              @unique // uppercase
  title        String
  description  String?
  /// Stored as string ("NA" allowed) to mirror legacy semantics.
  rate         String              @default("NA")
  isActive     Boolean             @default(true)
  isDefault    Boolean             @default(false)
  /// Optional department this code belongs to. Used as a hint for
  /// suggesting codes when assigning employees from the same dept.
  departmentId String?
  department   Department?         @relation(fields: [departmentId], references: [id])
  assignments  JobCodeAssignment[]
  primaryFor   Employee[]          @relation("PrimaryJobCode")
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  @@index([isActive])
  @@index([isDefault])
  @@index([departmentId])
}

model JobCodeAssignment {
  id           String   @id @default(cuid())
  jobCodeId    String
  jobCode      JobCode  @relation(fields: [jobCodeId], references: [id], onDelete: Cascade)
  employeeId   String
  employee     Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  assignedRate String   @default("NA")
  isPrimary    Boolean  @default(false)
  notes        String?  @db.Text
  assignedAt   DateTime @default(now())

  @@unique([jobCodeId, employeeId])
  @@index([employeeId])
}

// ──────────────────────────────────────────────────────────────────────
// Employee
// ──────────────────────────────────────────────────────────────────────

model Employee {
  id         String @id @default(cuid())
  /// Business ID like EMP-2026-0007.
  employeeId String @unique
  userId     String @unique @db.Uuid
  user       User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Identity
  name          String
  gender        Gender
  maritalStatus MaritalStatus?
  profilePic    String?
  /// bcrypt hash of the employee's kiosk PIN (self-set). Required to clock
  /// in/out at a shared kiosk terminal — never store the PIN itself.
  kioskPinHash  String?
  phoneNumber   String?
  dateOfBirth   DateTime?
  /// Work/company email. Optional — see User.email.
  email         String?        @unique
  /// Where login 2FA codes are sent — deliberately separate from the login
  /// email/username above, since some employees have no company email at all.
  /// Always required (every employee has *some* personal email), even when
  /// email above is null.
  personalEmail String

  /// IRS Treas. Reg. 31.6051-1 requires affirmative, electronically-confirmed
  /// consent before a W-2 can be furnished electronically instead of on
  /// paper — and the employee must be able to withdraw it. Null = no
  /// consent on file (or withdrawn) → W-2s must go out on paper, never
  /// through this system. Non-null = currently consented; the timestamp
  /// itself IS the "confirmed electronically" record the regulation wants.
  w2ConsentAt DateTime?

  /// Same posture as w2ConsentAt, but scoped to health & welfare plan
  /// documents (SPDs/SMMs/SBCs) under 29 CFR 2520.104b-1(c) — NOT the 401(k)
  /// notice-and-access safe harbor (29 CFR 2520.104b-31), which is a
  /// separate 2020 rule covering retirement plans only. A consent timestamp
  /// is necessary but not sufficient for that safe harbor: it also requires
  /// measures reasonably calculated to ensure actual receipt and notice, at
  /// the time of furnishing, of the document's significance and the right
  /// to a free paper copy — none of which is a database column. Counsel
  /// confirms which safe harbor the plan relies on before this is widened
  /// beyond health & welfare documents.
  benefitsEConsentAt DateTime?

  // Personal
  address        String?
  city           String?
  state          String?
  zipCode        String?
  /// Last 4 digits of the SSN only — the full number is never collected or
  /// stored. Payroll is processed externally (paystubs are uploaded as
  /// files), so last-4 is sufficient to reconcile a record against the
  /// payroll provider. NOT unique: across a few dozen employees last-4
  /// collisions are likely enough (~6% at n=35) that a unique index would
  /// eventually reject a legitimate hire.
  ssnLast4       String?  @db.VarChar(4)
  nationality    String?
  educationLevel String?
  certifications String[] @default([])
  emergencyName  String?
  emergencyPhone String?

  // Work
  departmentId      String?
  department        Department?      @relation(fields: [departmentId], references: [id])
  position          String?
  jobTitle          String?
  jobDescription    String?          @db.Text
  dateOfHire        DateTime?
  supervisorId      String?
  supervisor        Employee?        @relation("Supervisor", fields: [supervisorId], references: [id])
  reports           Employee[]       @relation("Supervisor")
  employmentType    EmploymentType   @default(FULL_PART_TIME)
  employmentStatus  EmploymentStatus @default(ACTIVE)
  terminationDate   DateTime?
  terminationReason String?
  exportCode        String?
  workEmail         String?
  workPhoneNumber   String?

  // Compensation
  compensationType  CompensationType
  compensationValue Decimal?         @db.Decimal(12, 2)
  primaryJobCodeId  String?
  primaryJobCode    JobCode?         @relation("PrimaryJobCode", fields: [primaryJobCodeId], references: [id])
  defaultHourlyRate Decimal          @default(25.00) @db.Decimal(10, 2)

  /// Vector embedding for semantic search + future AI features.
  /// 1536 dims = OpenAI / Anthropic default. Backfilled by scripts/embed.ts.
  embedding Unsupported("vector(1536)")?

  // Leave summary cached for fast dashboard reads
  totalLeaves     Int @default(20)
  leavesTaken     Int @default(0)
  leavesApproved  Int @default(0)
  leavesRejected  Int @default(0)
  leavesRemaining Int @default(20)

  // Relations
  jobCodes               JobCodeAssignment[]
  timeEntries            TimeEntry[]
  schedules              Schedule[]
  scheduledWork          ScheduledWork[]
  approvedEntries        TimeEntry[]             @relation("ApprovedBy")
  leaveRequests          LeaveRequest[]
  reviewedLeaves         LeaveRequest[]          @relation("LeaveReviewer")
  requests               Request[]
  reviewedRequests       Request[]               @relation("RequestReviewer")
  reimbursements         Reimbursement[]
  reviewedReimbursements Reimbursement[]         @relation("ReimbursementReviewer")
  documents              Document[]
  uploadedDocuments      Document[]              @relation("DocumentUploader")
  payrollDocs            Payroll[]
  uploadedPayroll        Payroll[]               @relation("PayrollUploader")
  notifications          NotificationRecipient[]
  benefitEnrollments     BenefitEnrollment[]
  retirementElections    RetirementElection[]
  hirePacketImports      HirePacketImport[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([departmentId, employmentStatus])
  @@index([employmentType])
  @@index([supervisorId])
}

// ──────────────────────────────────────────────────────────────────────
// Time tracking
// ──────────────────────────────────────────────────────────────────────

model TimeEntry {
  id              String          @id @default(cuid())
  employeeId      String
  employee        Employee        @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  date            DateTime        @db.Date
  clockIn         DateTime
  clockOut        DateTime?
  totalBreakMin   Int             @default(0)
  totalWorkMin    Int             @default(0)
  status          TimeEntryStatus @default(ACTIVE)
  jobCode         String          @default("ACT001")
  rate            Decimal?        @db.Decimal(10, 2)
  timesheetNotes  String?         @db.Text
  source          TimeEntrySource @default(WEB)
  /// When source = KIOSK, the slug + label of the kiosk that recorded
  /// this entry. Stored denormalised so reports survive kiosk deletion.
  kioskSlug       String?
  kioskLabel      String?
  // Manager approval
  approvalStatus  ApprovalStatus  @default(PENDING)
  approvedById    String?
  approvedBy      Employee?       @relation("ApprovedBy", fields: [approvedById], references: [id])
  approvalDate    DateTime?
  approvalNotes   String?         @db.Text
  // Children
  breaks          TimeBreak[]
  // From scheduled work?
  scheduledWorkId String?         @unique
  scheduledWork   ScheduledWork?  @relation(fields: [scheduledWorkId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([employeeId, date])
  @@index([status])
  @@index([approvalStatus])
  @@index([date])
}

model TimeBreak {
  id          String    @id @default(cuid())
  timeEntryId String
  timeEntry   TimeEntry @relation(fields: [timeEntryId], references: [id], onDelete: Cascade)
  startTime   DateTime
  endTime     DateTime?
  durationMin Int       @default(0)
  type        BreakType @default(BREAK)
}

// ──────────────────────────────────────────────────────────────────────
// Scheduling (single-day)
// ──────────────────────────────────────────────────────────────────────

model Schedule {
  id          String   @id @default(cuid())
  employeeId  String
  employee    Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  date        DateTime @db.Date
  jobCode     String
  startTime   String // "HH:MM"
  endTime     String // "HH:MM"
  notes       String?  @db.Text
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([employeeId, date])
  @@index([date])
  @@index([employeeId, date, startTime, endTime])
}

model ScheduleTemplate {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  jobCode     String?
  // 7-day pattern (Mon..Sun)
  monday      Boolean  @default(true)
  tuesday     Boolean  @default(true)
  wednesday   Boolean  @default(true)
  thursday    Boolean  @default(true)
  friday      Boolean  @default(true)
  saturday    Boolean  @default(false)
  sunday      Boolean  @default(false)
  hoursPerDay Float
  startTime   String
  endTime     String
  isActive    Boolean  @default(true)
  notes       String?  @db.Text
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isActive])
}

// ──────────────────────────────────────────────────────────────────────
// Scheduled work (auto-timesheet source for FT/PT employees)
// ──────────────────────────────────────────────────────────────────────

model ScheduledWork {
  id                  String              @id @default(cuid())
  employeeId          String
  employee            Employee            @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  date                DateTime            @db.Date
  startTime           DateTime
  endTime             DateTime
  status              ScheduledWorkStatus @default(SCHEDULED)
  timesheetGenerated  Boolean             @default(false)
  jobCode             String
  rate                Decimal             @db.Decimal(10, 2)
  notes               String?             @db.Text
  totalBreakMin       Int                 @default(0)
  netWorkHours        Float               @default(0)
  // Recurring (optional)
  recurringEnabled    Boolean             @default(false)
  recurringPattern    RecurringPattern?
  recurringDaysOfWeek Int[]               @default([])
  recurringEndDate    DateTime?           @db.Date
  // Generated timesheet
  generatedEntry      TimeEntry?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([employeeId, date])
  @@index([status])
  @@index([date, status])
}

// ──────────────────────────────────────────────────────────────────────
// Leave management
// ──────────────────────────────────────────────────────────────────────

model LeaveRequest {
  id          String      @id @default(cuid())
  employeeId  String
  employee    Employee    @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  leaveType   LeaveType
  startDate   DateTime    @db.Date
  endDate     DateTime    @db.Date
  totalDays   Int
  noticeDays  Int         @default(0)
  description String?     @db.Text
  status      LeaveStatus @default(PENDING)
  // Review
  reviewerId  String?
  reviewer    Employee?   @relation("LeaveReviewer", fields: [reviewerId], references: [id])
  reviewedAt  DateTime?
  reviewNotes String?     @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([employeeId, status])
  @@index([status, createdAt])
  @@index([startDate, endDate])
}

// ──────────────────────────────────────────────────────────────────────
// General requests (12 types) + status history
// ──────────────────────────────────────────────────────────────────────

model Request {
  id          String        @id @default(cuid())
  employeeId  String
  employee    Employee      @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  type        RequestType
  title       String
  description String        @db.Text
  status      RequestStatus @default(PENDING)
  adminNotes  String?       @db.Text
  reviewerId  String?
  reviewer    Employee?     @relation("RequestReviewer", fields: [reviewerId], references: [id])

  history RequestStatusHistory[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([employeeId, status])
  @@index([status, createdAt])
  @@index([type])
}

model RequestStatusHistory {
  id          String        @id @default(cuid())
  requestId   String
  request     Request       @relation(fields: [requestId], references: [id], onDelete: Cascade)
  status      RequestStatus
  note        String?       @db.Text
  updatedById String?
  updatedAt   DateTime      @default(now())

  @@index([requestId, updatedAt])
}

// ──────────────────────────────────────────────────────────────────────
// Reimbursements + receipts + status history
// ──────────────────────────────────────────────────────────────────────

model Reimbursement {
  id                 String                @id @default(cuid())
  employeeId         String
  employee           Employee              @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  title              String
  category           ReimbursementCategory
  amount             Decimal               @db.Decimal(12, 2)
  currency           String                @default("USD")
  description        String                @db.Text
  expenseDate        DateTime              @db.Date
  status             ReimbursementStatus   @default(PENDING)
  priority           Priority              @default(MEDIUM)
  isRecurring        Boolean               @default(false)
  recurringFrequency RecurringFrequency?
  tags               String[]              @default([])

  reviewerId   String?
  reviewer     Employee? @relation("ReimbursementReviewer", fields: [reviewerId], references: [id])
  reviewedAt   DateTime?
  reviewNotes  String?   @db.Text
  approvalDate DateTime?
  paidDate     DateTime?
  paidAmount   Decimal?  @db.Decimal(12, 2)

  receipts ReimbursementReceipt[]
  history  ReimbursementStatusHistory[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([employeeId, status])
  @@index([status, createdAt])
  @@index([category])
  @@index([expenseDate])
}

model ReimbursementReceipt {
  id              String        @id @default(cuid())
  reimbursementId String
  reimbursement   Reimbursement @relation(fields: [reimbursementId], references: [id], onDelete: Cascade)
  fileName        String
  originalName    String
  fileUrl         String
  fileSize        Int
  mimeType        String
  uploadedAt      DateTime      @default(now())
}

model ReimbursementStatusHistory {
  id              String              @id @default(cuid())
  reimbursementId String
  reimbursement   Reimbursement       @relation(fields: [reimbursementId], references: [id], onDelete: Cascade)
  status          ReimbursementStatus
  note            String?             @db.Text
  updatedById     String?
  updatedAt       DateTime            @default(now())

  @@index([reimbursementId, updatedAt])
}

// ──────────────────────────────────────────────────────────────────────
// Notifications (broadcast w/ per-recipient read state)
// ──────────────────────────────────────────────────────────────────────

model Notification {
  id         String                       @id @default(cuid())
  type       NotificationType
  title      String
  message    String                       @db.Text
  priority   Priority                     @default(MEDIUM)
  link       String?
  metadata   Json?
  senderId   String?                      @db.Uuid
  recipients NotificationRecipient[]
  createdAt  DateTime                     @default(now())
  /// Embedding of (title + message) for similarity search.
  embedding  Unsupported("vector(1024)")?

  @@index([createdAt])
  @@index([type, createdAt])
}

model NotificationRecipient {
  id             String       @id @default(cuid())
  notificationId String
  notification   Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  employeeId     String
  employee       Employee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  read           Boolean      @default(false)
  readAt         DateTime?

  @@unique([notificationId, employeeId])
  @@index([employeeId, read])
  @@index([employeeId, notificationId])
}

// ──────────────────────────────────────────────────────────────────────
// Documents + Payroll
// ──────────────────────────────────────────────────────────────────────

model Document {
  id                 String                       @id @default(cuid())
  title              String
  description        String?                      @db.Text
  fileName           String
  fileType           String
  fileUrl            String
  documentType       DocumentType
  /// Owner of the document — for personal docs, scopes the read.
  employeeId         String
  employee           Employee                     @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  uploadedById       String?                      @db.Uuid
  uploaderEmployeeId String?
  uploader           Employee?                    @relation("DocumentUploader", fields: [uploaderEmployeeId], references: [id])
  uploadedAt         DateTime                     @default(now())
  /// Document body embedding for semantic search.
  embedding          Unsupported("vector(1024)")?

  @@index([documentType])
  @@index([employeeId, documentType])
}

model Payroll {
  id                 String    @id @default(cuid())
  employeeId         String
  employee           Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  title              String
  description        String?
  category           String    @default("General")
  fileName           String
  fileType           String
  fileUrl            String
  payPeriodStart     DateTime  @db.Date
  payPeriodEnd       DateTime  @db.Date
  uploadedById       String?   @db.Uuid
  uploaderEmployeeId String?
  uploader           Employee? @relation("PayrollUploader", fields: [uploaderEmployeeId], references: [id])
  uploadedAt         DateTime  @default(now())

  @@index([employeeId, payPeriodEnd])
  @@index([payPeriodStart])
  @@index([category])
}

/// Admin-uploaded onboarding zip for one employee — extracted fields await HR review.
model HirePacketImport {
  id            String                  @id @default(cuid())
  employeeId    String
  employee      Employee                @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  uploadedById  String                  @db.Uuid
  uploadedBy    User                    @relation("HirePacketUploads", fields: [uploadedById], references: [id])
  status        HirePacketImportStatus  @default(PENDING)
  zipFileName   String
  /// S3 object key under documents/hire-packets/…
  zipStorageKey String
  /// Proposed employee fields keyed by updateEmployee field names.
  proposedFields Json?
  /// Per-file extraction metadata (form type, documentId, warnings).
  fileResults   Json?
  errorMessage  String?                 @db.Text
  createdAt     DateTime                @default(now())
  updatedAt     DateTime                @updatedAt
  processedAt   DateTime?
  appliedAt     DateTime?

  @@index([employeeId, createdAt(sort: Desc)])
  @@index([status])
}

model PayrollCalendar {
  id             String              @id @default(cuid())
  title          String
  payPeriodStart DateTime            @db.Date
  payPeriodEnd   DateTime            @db.Date
  payDate        DateTime            @db.Date
  status         PayrollPeriodStatus @default(UPCOMING)
  notes          String?             @db.Text
  createdById    String              @db.Uuid
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  @@index([payDate])
  @@index([status])
}

// ──────────────────────────────────────────────────────────────────────
// Benefits — medical / dental / vision / 401(k)
//
// This app is a read-only mirror of what the broker/carrier already
// administers, not a system of record: no in-app elections, no
// open-enrollment window, no carrier EDI. Three privacy rules apply
// throughout — no PHI (diagnoses, claims, conditions), no dependent
// identities (we store the coverage tier, never who the family is), and no
// 401(k) balances (those live with the recordkeeper).
// ──────────────────────────────────────────────────────────────────────

/// The benefits catalog, scoped to one plan year. A renewal creates a NEW
/// row here rather than editing the old one — that is what freezes
/// historical premiums, since an enrollment resolves its cost against
/// whichever plan row was active while it was in force. Never edit a plan's
/// dates or tier prices once enrollments exist against it; roll forward
/// (clone + re-point) instead.
model BenefitPlan {
  id               String  @id @default(cuid())
  type             BenefitType
  name             String
  carrierName      String
  groupNumber      String?
  carrierPhone     String?
  carrierPortalUrl String?
  planYearStart    DateTime @db.Date
  planYearEnd      DateTime @db.Date
  /// Brokers quote monthly; payroll deducts per paycheck. Required and
  /// load-bearing — a monthly rate typed into a per-paycheck field shows a
  /// semi-monthly employee ~2.17x what actually leaves their paycheck.
  costPeriod BenefitCostPeriod @default(PER_PAYCHECK)
  /// 401(k) only. Free text copied verbatim from the plan document (e.g.
  /// "100% of the first 3%, then 50% of the next 2%") rather than a
  /// structured formula — structuring it invites the UI to compute a
  /// projected match, which an employee will read as a promise. Safe-harbor
  /// variants, true-up rules, and hours-of-service eligibility mean any
  /// structured model is wrong for someone.
  matchDescription   String? @db.Text
  vestingDescription String? @db.Text
  isActive           Boolean @default(true)
  notes              String? @db.Text
  /// No relation — mirrors PayrollCalendar.createdById.
  createdById String?  @db.Uuid
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tiers       BenefitPlanTier[]
  enrollments BenefitEnrollment[]
  elections   RetirementElection[]

  @@unique([type, name, planYearStart])
  @@index([isActive, type])
  @@index([planYearEnd])
}

/// The price list for a plan. Only medical/dental/vision plans have tiers —
/// a 401(k) plan has none.
model BenefitPlanTier {
  id           String       @id @default(cuid())
  planId       String
  plan         BenefitPlan  @relation(fields: [planId], references: [id], onDelete: Cascade)
  tier         CoverageTier
  /// Always annotate Decimal — a bare Decimal maps to numeric(65,30).
  employeeCost Decimal @db.Decimal(10, 2)
  employerCost Decimal @db.Decimal(10, 2)

  @@unique([planId, tier])
}

/// One employee, one plan, one continuous span of coverage. A tier change is
/// always END + NEW ROW, never an in-place edit — editing destroys the
/// record of what the employee was paying before the change, which is the
/// one thing a payroll-deduction mirror exists to preserve. Whether coverage
/// is current is always DERIVED from effectiveDate/endDate — there is no
/// stored ACTIVE/ENDED flag, because a stored flag goes stale the day after
/// it's written.
model BenefitEnrollment {
  id         String   @id @default(cuid())
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  planId     String
  /// Restrict, not Cascade — deleting a plan people were covered under must
  /// fail loudly, not silently erase their coverage history.
  plan BenefitPlan @relation(fields: [planId], references: [id], onDelete: Restrict)
  /// Null when status is WAIVED.
  tier   CoverageTier?
  /// WAIVED is not optional to omit: without it, "no rows for this type"
  /// means both "you declined" and "HR hasn't entered your data yet," and an
  /// employee who is actually covered would see a page implying otherwise.
  status BenefitEnrollmentStatus

  effectiveDate DateTime  @db.Date
  endDate       DateTime? @db.Date
  memberId      String?

  /// Nullable OVERRIDES, not snapshots. Null = "the standard rate for this
  /// tier," resolved from BenefitPlanTier at read time. Non-null = a
  /// deliberate exception (class-based subsidy, grandfathered rate, tobacco
  /// surcharge). Named `...Override` so nobody later mistakes these for a
  /// cache and writes a "sync from catalog" job.
  employeeCostOverride Decimal? @db.Decimal(10, 2)
  employerCostOverride Decimal? @db.Decimal(10, 2)

  /// Stamped on every mutation, not just create — a timestamp that only
  /// records first entry looks authoritative while being stale.
  confirmedAsOf DateTime @db.Date
  notes         String?  @db.Text
  createdById   String?  @db.Uuid
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([employeeId, planId, effectiveDate])
  @@index([employeeId, effectiveDate(sort: Desc)])
  @@index([planId])
}

/// 401(k) elections — deliberately separate from BenefitEnrollment, since
/// nothing about the economics matches: no tier, no premium, a percentage of
/// pay plus an employer formula instead. Folding the two together would
/// leave several permanently-null columns on every row of one model or the
/// other, with no expressible invariant.
model RetirementElection {
  id         String      @id @default(cuid())
  employeeId String
  employee   Employee    @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  planId     String
  plan       BenefitPlan @relation(fields: [planId], references: [id], onDelete: Restrict)
  status     BenefitEnrollmentStatus

  /// Decimal(5,2), not (10,2) — a percentage is not money. Percent-vs-flat
  /// exclusivity is enforced in Zod, not the DB.
  preTaxPercent    Decimal? @db.Decimal(5, 2)
  rothPercent      Decimal? @db.Decimal(5, 2)
  flatAmountPerPay Decimal? @db.Decimal(10, 2)

  effectiveDate DateTime  @db.Date
  endDate       DateTime? @db.Date
  confirmedAsOf DateTime  @db.Date
  notes         String?   @db.Text
  createdById   String?   @db.Uuid
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@unique([employeeId, planId, effectiveDate])
  @@index([employeeId, effectiveDate(sort: Desc)])
  @@index([planId])
}

model CompanyDefault {
  id              String   @id @default(cuid())
  name            String   @unique
  hoursPerDay     Float
  startTime       String
  endTime         String
  includeWeekends Boolean  @default(false)
  isActive        Boolean  @default(true)
  isDefault       Boolean  @default(false)
  createdById     String   @db.Uuid
  updatedAt       DateTime @updatedAt
  createdAt       DateTime @default(now())
}

// ──────────────────────────────────────────────────────────────────────
// Kiosk + Onboarding
// ──────────────────────────────────────────────────────────────────────

model KioskSession {
  id            String    @id @default(cuid())
  /// URL slug used in /kiosk/[slug] — lowercase alphanumeric + hyphens.
  /// Persistent across deployments so the same physical terminal keeps
  /// the same URL even after re-provisioning. Nullable for legacy rows
  /// pre-dating the slug column; new rows are always populated.
  slug          String?   @unique
  cookieHash    String?   @unique
  provisionedBy String    @db.Uuid // admin user id
  label         String?
  expiresAt     DateTime
  revokedAt     DateTime?
  lastUsedAt    DateTime?
  ip            String?
  userAgent     String?
  createdAt     DateTime  @default(now())

  @@index([revokedAt])
  @@index([expiresAt])
  @@index([slug])
}

model OnboardingInvite {
  id                    String       @id @default(cuid())
  token                 String       @unique
  email                 String?
  status                InviteStatus @default(PENDING)
  expiresAt             DateTime
  createdById           String       @db.Uuid
  completedAt           DateTime?
  completedByEmployeeId String?
  createdAt             DateTime     @default(now())

  @@index([status])
  @@index([expiresAt])
}

// ──────────────────────────────────────────────────────────────────────
// Audit log (every write + sensitive read)
// ──────────────────────────────────────────────────────────────────────

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?  @db.Uuid
  actor      User?    @relation("ActorAuditLogs", fields: [actorId], references: [id])
  actorEmail String?
  action     String // e.g. 'employee.create', 'leave.approve', 'ssn.view'
  resource   String // e.g. 'Employee:cm123abc'
  /// Old → new diff for write operations; null for reads.
  diff       Json?
  ip         String?
  userAgent  String?
  createdAt  DateTime @default(now())

  @@index([resource, createdAt])
  @@index([actorId, createdAt])
  @@index([action, createdAt])
}

// ──────────────────────────────────────────────────────────────────────
// Knowledge base + Agentic RAG (act-erp-ai)
//
// Prisma owns these tables; the Python `ai` service reads/writes them via raw
// SQL. Embeddings are vector(1024) (Bedrock Titan Text Embeddings v2). The tsv
// full-text column, pgvector (HNSW) indexes, and RLS policies are added by the
// raw-SQL migration in prisma/sql/01_rag_pgvector_rls.sql (Prisma can't express
// them on Unsupported columns). RLS hard-scopes reads by app.allowed_docs as
// defense-in-depth behind the app-layer WHERE filters. See ARCHITECTURE.md §6.
// ──────────────────────────────────────────────────────────────────────

/// A document in the knowledge base (separate from the HR `Document` model).
/// Tool records, BOMs, operational docs, spreadsheets.
model KnowledgeDocument {
  id             String          @id @default(cuid())
  title          String
  sourceFilename String
  mimeType       String
  fileKind       FileKind
  s3Key          String
  /// sha256 of the file bytes — global dedup; identical re-upload short-circuits.
  checksum       String          @unique
  uploadedById   String          @db.Uuid
  uploadedBy     User            @relation("KnowledgeUploads", fields: [uploadedById], references: [id])
  /// Set for employee self-uploads; with visibility = PRIVATE scopes to the owner.
  ownerUserId    String?         @db.Uuid
  owner          User?           @relation("KnowledgeOwned", fields: [ownerUserId], references: [id])
  visibility     DocVisibility   @default(PRIVATE)
  status         IngestStatus    @default(QUEUED)
  failureReason  String?         @db.Text
  pageDimensions Json?
  grants         DocumentGrant[]
  structureNodes StructureNode[]
  chunks         Chunk[]
  images         DocImage[]
  recordTables   RecordTable[]
  recordRows     RecordRow[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([status])
  @@index([ownerUserId])
  @@index([visibility])
}

/// Per-user read grant. visibility = ORG bypasses this; admins see all in app code.
/// Department assignment is expanded to per-user rows in the frontend.
model DocumentGrant {
  id          String            @id @default(cuid())
  documentId  String
  document    KnowledgeDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  userId      String            @db.Uuid
  user        User              @relation("KnowledgeGrants", fields: [userId], references: [id], onDelete: Cascade)
  grantedById String?           @db.Uuid
  createdAt   DateTime          @default(now())

  @@unique([documentId, userId])
  @@index([userId])
}

/// Heading tree for PDF/DOCX (powers get_toc / read_section).
model StructureNode {
  id          String            @id @default(cuid())
  documentId  String
  document    KnowledgeDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  parentId    String?
  parent      StructureNode?    @relation("NodeChildren", fields: [parentId], references: [id])
  children    StructureNode[]   @relation("NodeChildren")
  depth       Int
  headingText String?
  breadcrumb  String?           @db.Text
  pageStart   Int?
  pageEnd     Int?
  chunks      Chunk[]

  @@index([documentId])
  @@index([parentId])
}

/// Text passage for hybrid retrieval. `tsv` (tsvector) + the HNSW/GIN indexes
/// are added by the raw-SQL migration.
model Chunk {
  id              String                       @id @default(cuid())
  documentId      String
  document        KnowledgeDocument            @relation(fields: [documentId], references: [id], onDelete: Cascade)
  structureNodeId String?
  structureNode   StructureNode?               @relation(fields: [structureNodeId], references: [id])
  content         String                       @db.Text
  contentHtml     String?                      @db.Text
  pageNumber      Int?
  bbox            Json?
  polygon         Json?
  tokenCount      Int?
  embedding       Unsupported("vector(1024)")?
  createdAt       DateTime                     @default(now())

  @@index([documentId])
  @@index([structureNodeId])
}

/// Figures/tables for the visualizer.
model DocImage {
  id            String            @id @default(cuid())
  documentId    String
  document      KnowledgeDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  pageNumber    Int?
  bbox          Json?
  caption       String?           @db.Text
  figureRefNorm String?
  s3Key         String

  @@unique([documentId, figureRefNorm])
  @@index([documentId])
}

/// One extracted/ingested structured table (BOM, tool-record sheet, CSV/XLSX).
model RecordTable {
  id         String            @id @default(cuid())
  documentId String
  document   KnowledgeDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  name       String
  /// Column names/types inferred at ingestion.
  schemaJson Json
  rows       RecordRow[]
  createdAt  DateTime          @default(now())

  @@index([documentId])
}

/// Generic, scope-safe row store. The query_records tool reads dataJson with
/// JSON operators; documentId carries the RLS scope.
model RecordRow {
  id            String                       @id @default(cuid())
  recordTableId String
  recordTable   RecordTable                  @relation(fields: [recordTableId], references: [id], onDelete: Cascade)
  documentId    String
  document      KnowledgeDocument            @relation(fields: [documentId], references: [id], onDelete: Cascade)
  dataJson      Json
  rowEmbedding  Unsupported("vector(1024)")?

  @@index([recordTableId])
  @@index([documentId])
}

/// One agent turn — provenance + suspend/resume + SSE replay.
model AgentRun {
  id          String          @id @default(cuid())
  userId      String          @db.Uuid
  user        User            @relation("AgentRuns", fields: [userId], references: [id])
  status      String          @default("running")
  /// Snapshot of the allowed_doc_ids the run was scoped to.
  scopeDocIds Json
  /// Suspend/resume checkpoint (HITL).
  stateJson   Json?
  events      AgentRunEvent[]
  evidence    EvidenceLog[]
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([userId, createdAt])
}

/// Append-only SSE event log (seq enables reconnect-replay).
model AgentRunEvent {
  id        String   @id @default(cuid())
  runId     String
  run       AgentRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  seq       Int
  type      String
  dataJson  Json
  createdAt DateTime @default(now())

  @@unique([runId, seq])
  @@index([runId, seq])
}

/// Citation [E#] → source mapping. sourceKind spans both retrieval modes.
model EvidenceLog {
  id         String   @id @default(cuid())
  runId      String
  run        AgentRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  eid        String
  sourceKind String // 'chunk' | 'row'
  sourceId   String
  createdAt  DateTime @default(now())

  @@index([runId])
}

