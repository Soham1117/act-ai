# ─────────────────────────────────────────────────────────────────────
# E2E TEST ENVIRONMENT — fake values only. Safe to commit.
# Used by Playwright (playwright.config.ts) and the seed script
# (e2e/seed.ts). Never put real credentials in this file.
# ─────────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://act:act@localhost:5433/act_e2e
DIRECT_URL=postgresql://act:act@localhost:5433/act_e2e
AUTH_SECRET=e2e-test-secret-not-for-production-0123456789
AUTH_TRUST_HOST=true
LOGIN_2FA_ENABLED=false
EMAIL_PROVIDER=ses
SES_FROM_EMAIL=noreply@e2e.test
# AWS_ENDPOINT_URL points at the in-memory fake S3 (e2e/support/fake-s3.ts); set by playwright.config.ts.
AWS_REGION=us-east-2
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
S3_BUCKET=e2e-bucket
AI_ENABLED=false
# NEXT_PUBLIC_SITE_URL is derived from E2E_PORT in playwright.config.ts.
# Kiosk network rule: only this range counts as "the facility".
# Tests send X-Forwarded-For to pretend to be inside or outside it.
KIOSK_ALLOWED_NETWORKS=10.99.0.0/16

# ── Test users (fake) ──
E2E_ADMIN_EMAIL=admin@e2e.test
E2E_ADMIN_PASSWORD=E2e-Admin-Pass-1!
E2E_EMPLOYEE_EMAIL=erin@e2e.test
E2E_EMPLOYEE_PASSWORD=E2e-Employee-Pass-1!
E2E_INACTIVE_EMAIL=ivan@e2e.test
E2E_INACTIVE_PASSWORD=E2e-Inactive-Pass-1!
E2E_EMPLOYEE_PIN=4826
# Raw device cookie for the pre-activated kiosk (its hash is seeded in the DB).
E2E_KIOSK_COOKIE=e2e-kiosk-device-cookie-not-secret
